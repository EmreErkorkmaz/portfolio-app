// Cloudflare Workers config for the Git-connected Worker "emre-erkorkmaz" (Workers Builds).
// `name` must match the Worker in the dashboard or the build fails.
// The site is static: no Worker script, only the Astro build output as assets.
{
  "name": "emre-erkorkmaz",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths (Workers default is an empty 404).
    "not_found_handling": "404-page",
    // /tr/index.html is served at /tr/, 404.html at /404.
    "html_handling": "auto-trailing-slash",
  },
}
