---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/ui';

const tr = useTranslations('tr');
const en = useTranslations('en');
---

<Base lang="en" title={`404 — ${en('notfound.title')}`} description={en('notfound.lead')} noindex>
  <main class="nf container">
    <p class="nf__code">404</p>
    <h1>{en('notfound.title')}</h1>
    <p class="nf__lead">{en('notfound.lead')}</p>
    <p class="nf__lead" lang="tr">
      {tr('notfound.lead')}
    </p>
    <div class="nf__actions">
      <a class="btn btn--accent" href="/">
        {en('notfound.back')}
      </a>
      <a class="btn btn--ghost" href="/tr/" lang="tr">
        {tr('notfound.back')}
      </a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-m);
  }

  .nf__code {
    font-family: var(--font-display), var(--font-body);
    font-size: clamp(6rem, 4rem + 10vw, 12rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h1 {
    font-size: var(--step-4);
  }

  .nf__lead {
    color: var(--fg-muted);
    max-width: 50ch;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
