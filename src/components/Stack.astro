---
import { useTranslations, type Lang } from '../i18n/ui';
import { stack, learning } from '../data/stack';
import { techServices } from '../data/services';
import { icons } from '../data/icons';
import SplitWords from './SplitWords.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const dots = { expert: 3, advanced: 2, intermediate: 1 } as const;
---

<section id="stack" class="section" aria-labelledby="stack-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>
        {t('stack.eyebrow')}
      </p>
      <h2 id="stack-title" class="section-title" data-split>
        <SplitWords text={t('stack.title')} />
      </h2>
    </header>

    <ul class="tech-services">
      {techServices.map((s, i) => (
        <li class="tech-service" data-reveal data-i={String(i % 3)}>
          <span class="tech-service__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d={icons[s.icon]}
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <h3 class="tech-service__title">{s.title[lang]}</h3>
          <p class="tech-service__body">{s.body[lang]}</p>
          <p class="tech-service__tags">{s.tags.join(' · ')}</p>
        </li>
      ))}
    </ul>

    <header class="skills-head">
      <h3 class="skills-title" data-reveal>
        {t('stack.skills')}
      </h3>
      <ul class="legend" data-reveal data-i="1">
        {(['expert', 'advanced', 'intermediate'] as const).map((lvl) => (
          <li>
            <span class="level" data-level={dots[lvl]} aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            {t(`level.${lvl}`)}
          </li>
        ))}
      </ul>
    </header>

    <div class="groups">
      {stack.map((g, gi) => (
        <section
          class="group"
          data-reveal
          data-i={String(gi % 3)}
          aria-labelledby={`stack-${g.id}`}
        >
          <h4 id={`stack-${g.id}`} class="group__title">
            {g.title[lang]}
          </h4>
          <span class="group__rule" data-draw="x" aria-hidden="true" />
          <ul class="group__items">
            {g.items.map((item) => (
              <li class="item">
                <span>{item.name}</span>
                <span class="level" data-level={dots[item.level]} title={t(`level.${item.level}`)}>
                  <i />
                  <i />
                  <i />
                  <span class="visually-hidden">{t(`level.${item.level}`)}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="learning" data-reveal>
      <span class="learning__label">{t('stack.learning')}</span>
      {learning.map((l) => (
        <span class="tag">{l}</span>
      ))}
    </p>
  </div>
</section>

<style>
  /* Flex rather than grid so a partial last row stretches instead of leaving empty cells. */
  .tech-services {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin-bottom: var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }

  .tech-service {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--space-m);
    background: var(--bg);
  }

  .tech-service__icon {
    color: var(--accent-ink);
  }

  .tech-service__icon svg {
    width: 24px;
    height: 24px;
  }

  .tech-service__title {
    font-size: var(--step-1);
  }

  .tech-service__body {
    flex: 1;
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .tech-service__tags {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
  }

  .skills-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: var(--space-l);
  }

  .skills-title {
    font-size: var(--step-3);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-l) var(--space-m);
  }

  .group__title {
    font-size: var(--step-2);
  }

  .group__rule {
    display: block;
    height: 1px;
    margin: 14px 0 6px;
    background: linear-gradient(90deg, var(--accent), var(--line-strong) 60%);
  }

  .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px dashed var(--line);
  }

  .level {
    display: inline-flex;
    gap: 4px;
  }

  .level i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .level[data-level='1'] i:nth-child(-n + 1),
  .level[data-level='2'] i:nth-child(-n + 2),
  .level[data-level='3'] i:nth-child(-n + 3) {
    background: var(--accent);
  }

  .learning {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .learning__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin-right: 8px;
  }
</style>
