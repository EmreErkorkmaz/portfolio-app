---
import { useTranslations, type Lang } from '../i18n/ui';
import { capabilities, practices } from '../data/stack';
import SplitWords from './SplitWords.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="stack" class="section" aria-labelledby="stack-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>
        {t('stack.eyebrow')}
      </p>
      <h2 id="stack-title" class="section-title" data-split>
        <SplitWords text={t('stack.title')} />
      </h2>
      <p class="section-lead" data-reveal data-i="1">
        {t('stack.lead')}
      </p>
    </header>

    <ul class="caps">
      {capabilities.map((c, i) => (
        <li class="cap" data-reveal data-i={String(i % 3)}>
          <span class="cap__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="cap__title">{c.title[lang]}</h3>
          <p class="cap__body">{c.body[lang]}</p>
          <ul class="cap__items" aria-label={c.title[lang]}>
            {c.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <div class="practices" data-reveal>
      <h3 class="practices__label">{t('stack.practices')}</h3>
      <ul>
        {practices[lang].map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Flex rather than grid so a partial last row stretches instead of leaving empty cells. */
  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }

  .cap {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--space-m);
    background: var(--bg);
    transition: background-color 0.3s;
  }

  .cap:hover {
    background: var(--bg-elev);
  }

  .cap__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
  }

  .cap__title {
    font-size: var(--step-2);
  }

  .cap__body {
    flex: 1;
    color: var(--fg-muted);
  }

  .cap__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .practices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .practices__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .practices ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .practices li {
    font-weight: 600;
  }

  .practices li + li::before {
    content: '·';
    margin-right: 18px;
    color: var(--accent);
  }
</style>
