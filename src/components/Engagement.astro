---
import { useTranslations, type Lang } from '../i18n/ui';
import SplitWords from './SplitWords.astro';
import { engagement } from '../data/process';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const facts = [
  { label: t('engagement.remote'), value: `${site.location[lang]} · ${site.timezone}` },
  { label: lang === 'tr' ? 'Dil' : 'Languages', value: t('engagement.languages') },
];
---

<section class="section engagement" aria-labelledby="engagement-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>
        {t('engagement.eyebrow')}
      </p>
      <h2 id="engagement-title" class="section-title" data-split>
        <SplitWords text={t('engagement.title')} />
      </h2>
    </header>

    <ul class="models">
      {engagement.map((m, i) => (
        <li class="model card" data-reveal data-i={String(i)}>
          <h3 class="model__title">{m.title[lang]}</h3>
          <p class="model__body">{m.body[lang]}</p>
        </li>
      ))}
    </ul>

    <dl class="facts" data-reveal>
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .models {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .model {
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .model__title {
    font-size: var(--step-2);
  }

  .model__body {
    color: var(--fg-muted);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-l);
    margin: var(--space-l) 0 0;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .facts dd {
    margin: 4px 0 0;
    font-weight: 600;
  }
</style>
