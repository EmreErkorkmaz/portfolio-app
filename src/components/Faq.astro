---
import { useTranslations, type Lang } from '../i18n/ui';
import { faq } from '../data/faq';
import SplitWords from './SplitWords.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q[lang],
    acceptedAnswer: { '@type': 'Answer', text: item.a[lang] },
  })),
};
---

<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <header class="section-head faq__head">
      <p class="eyebrow" data-reveal>
        {t('faq.eyebrow')}
      </p>
      <h2 id="faq-title" class="section-title" data-split>
        <SplitWords text={t('faq.title')} />
      </h2>
    </header>

    <div class="faq__list">
      {faq.map((item, i) => (
        <details class="faq__item" data-reveal data-i={String(i % 3)}>
          <summary>{item.q[lang]}</summary>
          <p>{item.a[lang]}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
</section>

<style>
  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--space-l);
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq__item summary {
    position: relative;
    display: block;
    padding: 20px 48px 20px 0;
    font-family: var(--font-display), var(--font-body);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--accent-ink);
  }

  .faq__item summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: -16px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s var(--ease-out);
  }

  .faq__item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq__item p {
    max-width: 62ch;
    padding: 0 48px 24px 0;
    color: var(--fg-muted);
  }

  @media (max-width: 860px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .faq__head {
      position: static;
    }
  }
</style>
