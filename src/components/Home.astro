---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Cases from './Cases.astro';
import Stack from './Stack.astro';
import AiWork from './AiWork.astro';
import Process from './Process.astro';
import Engagement from './Engagement.astro';
import Contact from './Contact.astro';
import ScrollTop from './ScrollTop.astro';
import Faq from './Faq.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { smbFaq } from '../data/faq';
import { smbProcess } from '../data/process';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <a class="skip-link" href="#main">
    {t('skip')}
  </a>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Cases lang={lang} />
    <AiWork lang={lang} />
    <Process
      lang={lang}
      steps={smbProcess}
      eyebrow={t('process.eyebrow')}
      title={t('process.title')}
    />
    <Faq lang={lang} items={smbFaq} title={t('faq.title')} />
    <Stack lang={lang} />
    <Engagement lang={lang} />
    <Contact
      lang={lang}
      title={t('contact.title')}
      lead={t('contact.lead')}
      mailSubject={t('contact.mailSubject')}
    />
  </main>
  <ScrollTop lang={lang} />
</Base>

<script>
  import '../scripts/main.ts';
</script>
