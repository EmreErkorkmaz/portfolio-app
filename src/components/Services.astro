---
import { useTranslations, type Lang } from '../i18n/ui';
import { services } from '../data/services';
import { icons } from '../data/icons';
import SplitWords from './SplitWords.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>
        {t('services.eyebrow')}
      </p>
      <h2 id="services-title" class="section-title" data-split>
        <SplitWords text={t('services.title')} />
      </h2>
      <p class="section-lead" data-reveal data-i="1">
        {t('services.lead')}
      </p>
    </header>

    <ul class="services">
      {services.map((s, i) => (
        <li class="service card" data-reveal data-i={String(i % 2)}>
          <span class="service__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d={icons[s.icon]}
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <h3 class="service__title">{s.title[lang]}</h3>
          <p class="service__body">{s.body[lang]}</p>
          <p class="service__for">
            <span>{t('services.bestFor')}</span>
            {s.bestFor[lang]}
          </p>
          <div class="service__includes">
            <h4 class="service__label">{t('services.includes')}</h4>
            <ul>
              {s.includes[lang].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <p class="service__tech">
            <span>{t('services.tech')}:</span> {s.tech.join(' · ')}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: var(--space-m);
    overflow: hidden;
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.4s;
  }

  .service::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(
      500px circle at 0% 0%,
      color-mix(in srgb, var(--accent) 14%, transparent),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .service:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }

  .service:hover::before {
    opacity: 1;
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-ink);
  }

  .service__icon svg {
    width: 24px;
    height: 24px;
  }

  .service__title {
    font-size: var(--step-2);
    margin-top: 8px;
  }

  .service__body {
    color: var(--fg-muted);
    flex: 1;
  }

  .service__for {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--radius-s);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-weight: 500;
    line-height: 1.45;
  }

  .service__for span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .service__includes {
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .service__label {
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .service__includes li {
    position: relative;
    padding-left: 22px;
    color: var(--fg-muted);
  }

  .service__includes li + li {
    margin-top: 4px;
  }

  .service__includes li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 10px;
    height: 6px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  .service__tech {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .service__tech span {
    font-weight: 600;
  }
</style>
