---
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(t('contact.mailSubject'))}`;
const year = new Date().getFullYear();
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container contact__inner">
    <p class="eyebrow" data-reveal>
      {t('contact.eyebrow')}
    </p>
    <h2 id="contact-title" class="contact__title" data-reveal data-i="1">
      {t('contact.title')}
    </h2>
    <p class="contact__lead" data-reveal data-i="2">
      {t('contact.lead')}
    </p>

    <div class="contact__actions" data-reveal data-i="3">
      <a class="contact__mail" href={mailto}>
        <span>{site.email}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M7 17 17 7M8 7h9v9"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
      <button
        class="btn btn--ghost"
        type="button"
        data-copy={site.email}
        data-copied-label={t('contact.copied')}
        hidden
      >
        {t('contact.copy')}
      </button>
    </div>

    <ul class="contact__links" data-reveal data-i="4">
      <li>
        <a href={site.linkedin} rel="me noopener" target="_blank">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.github} rel="me noopener" target="_blank">
          GitHub
        </a>
      </li>
    </ul>
  </div>

  <footer class="footer container">
    <p>
      © {year} {site.name}
    </p>
    <p>{t('footer.built')}</p>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    padding-top: var(--space-xl);
    overflow: clip;
    isolation: isolate;
    background: var(--bg-sunk);
    border-top: 1px solid var(--line);
  }

  .contact__glow {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: -1;
    width: min(1000px, 120vw);
    aspect-ratio: 2;
    transform: translate(-50%, -40%);
    background: radial-gradient(
      ellipse at center,
      var(--glow-a),
      color-mix(in srgb, var(--glow-b) 50%, transparent) 40%,
      transparent 70%
    );
    filter: blur(40px);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-m);
    padding-bottom: var(--space-xl);
  }

  .contact__title {
    font-size: var(--step-5);
    max-width: 14ch;
  }

  .contact__lead {
    max-width: 52ch;
    color: var(--fg-muted);
    font-size: var(--step-1);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: var(--space-s);
  }

  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    max-width: 100%;
    min-height: 48px;
    padding: 0.7em 1.1em;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: clamp(0.875rem, 0.6rem + 1.6vw, 1.45rem);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s;
  }

  .contact__mail:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 16px 40px -12px var(--glow-a);
  }

  .contact__mail svg {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .contact__links {
    display: flex;
    gap: 24px;
  }

  .contact__links a {
    display: inline-block;
    padding-block: 10px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s;
  }

  .contact__links a:hover {
    text-decoration-color: var(--accent);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: var(--space-m);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
</style>
