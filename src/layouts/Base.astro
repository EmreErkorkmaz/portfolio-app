---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;

const pathFor = (l: Lang) => (l === defaultLang ? '/' : `/${l}/`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og-${lang}.png`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#person`,
      name: site.name,
      jobTitle: 'Freelance Full-Stack Engineer',
      email: `mailto:${site.email}`,
      url: Astro.site?.toString(),
      sameAs: [site.linkedin, site.github],
      knowsLanguage: ['tr', 'en'],
      address: { '@type': 'PostalAddress', addressLocality: 'Yalova', addressCountry: 'TR' },
    },
    {
      '@type': 'ProfessionalService',
      name: `${site.name} — Software Development`,
      url: Astro.site?.toString(),
      founder: { '@id': `${Astro.site}#person` },
      areaServed: 'Worldwide',
      description,
    },
  ],
};

// Runs before first paint: applies the saved theme and flags JS availability so
// scroll-reveal fallbacks only hide content when JS can reveal it again.
const bootScript = `(()=>{const d=document.documentElement;d.classList.add('js');try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch(e){}})()`;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noindex &&
      Object.keys(languages).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pathFor(l as Lang), Astro.site)} />
      ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}

    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline set:html={bootScript}></script>
    <Font cssVariable="--font-display" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class="grain">
    <slot />
  </body>
</html>
