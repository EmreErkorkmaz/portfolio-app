---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { defaultLang, languages, routePath, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  /** Language-neutral route after the locale prefix, e.g. '' (home) or 'services/'. */
  route?: string;
  /** False for pages that exist in one language only (no hreflang alternates). */
  translated?: boolean;
  /** Adds ProfessionalService structured data (the small-business services page). */
  service?: boolean;
}

const {
  lang,
  title,
  description,
  noindex = false,
  route = '',
  translated = true,
  service = false,
} = Astro.props;

const pathFor = (l: Lang) => routePath(l, route);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og-${lang}.png`, Astro.site);

const person = {
  '@type': 'Person',
  '@id': `${Astro.site}#person`,
  name: site.name,
  jobTitle: 'Senior Frontend / Fullstack Engineer',
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  sameAs: [site.linkedin, site.github],
  knowsLanguage: ['tr', 'en'],
  address: { '@type': 'PostalAddress', addressLocality: 'Yalova', addressCountry: 'TR' },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    ...(service
      ? [
          {
            '@type': 'ProfessionalService',
            name: `${site.name} — Software Development`,
            url: canonical.toString(),
            founder: { '@id': `${Astro.site}#person` },
            areaServed: 'Worldwide',
            description,
          },
        ]
      : []),
  ],
};

// Runs before first paint: applies the saved theme (and matching browser-chrome colour, so
// overscroll areas never flash the wrong colour) and flags JS availability so scroll-reveal
// fallbacks only hide content when JS can reveal it again.
const bootScript = `(()=>{const d=document.documentElement;d.classList.add('js');try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark'){d.dataset.theme=t;const c=t==='dark'?'#0b0b0f':'#f4f2ec';document.querySelectorAll('meta[name="theme-color"]').forEach(m=>m.content=c)}}catch(e){}})()`;

// English lives at "/". Visitors whose explicit choice (saved by the language switch) or,
// failing that, primary browser language is Turkish are sent to "/tr/" before anything
// renders. Only the default-language home page carries this; "/tr/" never redirects.
const isDefaultHome = lang === defaultLang && route === '' && !noindex;
const langScript = `(()=>{try{let l=null;try{l=localStorage.getItem('lang')}catch(e){}if(!l)l=((navigator.languages&&navigator.languages[0])||navigator.language||'').toLowerCase().slice(0,2);if(l==='tr')location.replace('/tr/'+location.search+location.hash)}catch(e){}})()`;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    {isDefaultHome && <script is:inline set:html={langScript}></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noindex &&
      translated &&
      Object.keys(languages).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pathFor(l as Lang), Astro.site)} />
      ))}
    {!noindex && translated && (
      <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLang), Astro.site)} />
    )}

    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline set:html={bootScript}></script>
    <Font cssVariable="--font-display" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class="grain">
    <slot />
  </body>
</html>
